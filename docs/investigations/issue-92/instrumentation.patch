diff --git a/apps/desktop/src/issue-92-preview-probe.ts b/apps/desktop/src/issue-92-preview-probe.ts
new file mode 100644
index 0000000..eab051b
--- /dev/null
+++ b/apps/desktop/src/issue-92-preview-probe.ts
@@ -0,0 +1,85 @@
+export interface Issue92PreviewStageEvent {
+  readonly stage: string;
+  readonly startEpochMilliseconds: number;
+  readonly endEpochMilliseconds: number;
+}
+
+export interface Issue92PreviewProbe {
+  readonly now: () => number;
+  readonly begin: (fixtureId: string) => void;
+  readonly record: (event: Issue92PreviewStageEvent) => void;
+  readonly addMetric: (name: string, value: number) => void;
+  readonly complete: () => void;
+}
+
+interface Issue92ProfilePayload {
+  readonly schema: 'issue-92-application-stage-profile-v1';
+  readonly fixtureId: string;
+  readonly dispatchStartEpochMilliseconds: number;
+  readonly events: readonly Issue92PreviewStageEvent[];
+  readonly metrics: Readonly<Record<string, number>>;
+}
+
+const PROFILE_PREFIX = 'issue92-stage-profile:';
+
+export function installIssue92PreviewProbe(
+  publish: (receipt: string) => void,
+): Issue92PreviewProbe {
+  let active = false;
+  let fixtureId = 'unrecognized';
+  let dispatchStartEpochMilliseconds = 0;
+  let events: Issue92PreviewStageEvent[] = [];
+  let metrics: Record<string, number> = {};
+  const now = (): number => performance.timeOrigin + performance.now();
+  const payload = (): Issue92ProfilePayload => ({
+    schema: 'issue-92-application-stage-profile-v1',
+    fixtureId,
+    dispatchStartEpochMilliseconds,
+    events,
+    metrics,
+  });
+  const probe: Issue92PreviewProbe = {
+    now,
+    begin(nextFixtureId): void {
+      active = true;
+      fixtureId = nextFixtureId;
+      dispatchStartEpochMilliseconds = now();
+      events = [];
+      metrics = {};
+      publish(`${PROFILE_PREFIX}running`);
+    },
+    record(event): void {
+      if (active) events.push(event);
+    },
+    addMetric(name, value): void {
+      if (active) metrics[name] = (metrics[name] ?? 0) + value;
+    },
+    complete(): void {
+      if (!active) return;
+      const materializationStart = now();
+      JSON.stringify(payload());
+      const materializationEnd = now();
+      events.push({
+        stage: 'probe-receipt-materialization',
+        startEpochMilliseconds: materializationStart,
+        endEpochMilliseconds: materializationEnd,
+      });
+      active = false;
+      publish(`${PROFILE_PREFIX}${JSON.stringify(payload())}`);
+    },
+  };
+  (
+    globalThis as typeof globalThis & {
+      __issue92PreviewProbe?: Issue92PreviewProbe;
+    }
+  ).__issue92PreviewProbe = probe;
+  return probe;
+}
+
+export function issue92PreviewProbe(): Issue92PreviewProbe | undefined {
+  return (
+    globalThis as typeof globalThis & {
+      readonly __issue92PreviewProbe?: Issue92PreviewProbe;
+    }
+  ).__issue92PreviewProbe;
+}
