diff --git a/packages/generation/src/issue-87-preview-probe.ts b/packages/generation/src/issue-87-preview-probe.ts
new file mode 100644
index 0000000..13e0018
--- /dev/null
+++ b/packages/generation/src/issue-87-preview-probe.ts
@@ -0,0 +1,19 @@
+interface Issue87PreviewProbeEvent {
+  readonly stage: string;
+  readonly startMs: number;
+  readonly endMs: number;
+  readonly details?: Readonly<Record<string, unknown>>;
+}
+
+interface Issue87PreviewProbe {
+  readonly now: () => number;
+  readonly record: (event: Issue87PreviewProbeEvent) => void;
+}
+
+export function issue87PreviewProbe(): Issue87PreviewProbe | undefined {
+  return (
+    globalThis as typeof globalThis & {
+      readonly __issue87PreviewProbe?: Issue87PreviewProbe;
+    }
+  ).__issue87PreviewProbe;
+}
