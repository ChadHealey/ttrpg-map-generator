{
  "name": "ttrpg-map-generator",
  "version": "0.1.0",
  "private": true,
  "description": "Offline world-to-region fantasy map generator and editor",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": "24.11.0",
    "pnpm": "11.19.0"
  },
  "scripts": {
    "dev": "corepack pnpm --filter @ttrpg-map/desktop tauri dev",
    "build": "tsc -b --pretty false && corepack pnpm --filter @ttrpg-map/desktop build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false && corepack pnpm --filter @ttrpg-map/desktop check",
    "test": "vitest run --passWithNoTests",
    "test:cross-platform": "node scripts/fixture-conventions.mjs check",
    "fixtures:update": "node scripts/fixture-conventions.mjs update",
    "rust:fmt": "cargo fmt --manifest-path apps/desktop/src-tauri/Cargo.toml --check",
    "rust:clippy": "cargo clippy --manifest-path apps/desktop/src-tauri/Cargo.toml --all-targets --all-features -- -D warnings",
    "rust:test": "cargo test --manifest-path apps/desktop/src-tauri/Cargo.toml --all-targets --all-features",
    "precommit": "node scripts/check-staged-files.mjs && corepack pnpm format:check && corepack pnpm lint",
    "prepare": "simple-git-hooks",
    "check": "corepack pnpm format:check && corepack pnpm lint && corepack pnpm typecheck && corepack pnpm test && corepack pnpm rust:fmt && corepack pnpm rust:clippy && corepack pnpm rust:test"
  },
  "simple-git-hooks": {
    "pre-commit": "corepack pnpm precommit"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.8.1",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-svelte": "3.23.0",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "4.1.1",
    "simple-git-hooks": "2.13.1",
    "typescript": "6.0.2",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  }
}
